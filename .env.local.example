# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# Hostnames below are the docker-compose service names. To run Django or pytest on
# the host instead, set POSTGRES_HOST=localhost, REDIS_HOST=localhost and
# REDIS_URL=redis://localhost:6379/0.

# --- Django ---
# DEBUG=True is for a laptop on your own network only: it leaks settings and
# tracebacks and allows any host. Set DEBUG=False (and fill in the lists below)
# BEFORE opening a Cloudflare/ngrok tunnel or sharing a link with anyone.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated. With DEBUG=True and these unset, any host/origin is accepted.
# ALLOWED_HOSTS=localhost,192.168.1.20,my-tunnel.trycloudflare.com
# CORS_ALLOWED_ORIGINS=http://localhost:8081,https://my-tunnel.trycloudflare.com
# Reverse proxies in front of Django (a Cloudflare tunnel = 1; direct LAN = 0).
NUM_PROXIES=0

# --- Postgres ---
POSTGRES_DB=seekerdb
POSTGRES_USER=seeker
POSTGRES_PASSWORD=seekerpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (cache, Celery broker, channel layer) ---
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- OTP ---
OTP_LENGTH=6
OTP_VALIDITY_MINUTES=10

# --- Email (console backend prints mail to the log; switch to SMTP to send) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@seeker.local

# --- AI triage (OpenAI) ---
OPENAI_API_KEY=

# --- File storage (MinIO, local S3) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=seeker-local
MINIO_SECURE=False

# --- Search (Typesense) ---
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=local-typesense-key

# --- Push notifications (Firebase service-account file, gitignored) ---
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
